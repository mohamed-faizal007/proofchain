# ---------- Backend ----------
APP_ENV=dev                       # dev | test | prod
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=25
PUBLIC_VERIFY=true               # allow /verify without login

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=120
SEED_PASSWORD=                    # demo-user password for app.scripts.seed; required when APP_ENV=prod

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=proofchain

# Object storage (MinIO locally; leave S3_ENDPOINT_URL empty to use real AWS S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=proofchain-docs
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_PRESIGN_EXPIRY_SECONDS=300

# Blockchain
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337                    # 31337 hardhat local, 11155111 sepolia
REGISTRY_ADDRESS=                 # written by contracts/scripts/deploy.ts
ANCHOR_PRIVATE_KEY=               # hardhat account #0 for local ONLY; never a funded mainnet key
CHAIN_CONFIRMATIONS=1             # use 2+ on sepolia
EXPLORER_TX_URL=                  # e.g. https://sepolia.etherscan.io/tx/

# NLP (AI never affects verdicts)
NLP_ENABLED=true
NLP_SPACY_MODEL=en_core_web_sm
NLP_EMBEDDINGS_ENABLED=true
NLP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLP_LLM_EXPLANATIONS=false        # optional richer explanations
ANTHROPIC_API_KEY=
NLP_LLM_MODEL=

# Contracts (used by hardhat.config.ts for sepolia)
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# ---------- Frontend (frontend/.env) ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_EXPLORER_TX_URL=
