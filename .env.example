# ---------- Backend ----------
# dev | test | prod
APP_ENV=dev
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=25
# allow /verify without login
PUBLIC_VERIFY=true
# per client IP per minute, 0 = off (ADR-022: keyed on the TCP peer, not X-Forwarded-For)
LOGIN_RATE_LIMIT_PER_MIN=10
VERIFY_RATE_LIMIT_PER_MIN=20

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=120
# demo-user password for app.scripts.seed; required when APP_ENV=prod
SEED_PASSWORD=

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=proofchain

# Object storage (MinIO locally; leave S3_ENDPOINT_URL empty to use real AWS S3)
# 127.0.0.1, not localhost (P8-02 review): on Windows "localhost" can resolve IPv6 (::1) first,
# MinIO isn't listening there, and each attempt burns the full 1s connect_timeout before
# botocore's retry falls back to IPv4 -- enough to tip GET /health's 2s per-probe budget into "down".
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=proofchain-docs
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_PRESIGN_EXPIRY_SECONDS=300

# Blockchain
CHAIN_RPC_URL=http://127.0.0.1:8545
# 31337 hardhat local, 11155111 sepolia
CHAIN_ID=31337
# written by contracts/scripts/deploy.ts
REGISTRY_ADDRESS=
# hardhat account #0 for local ONLY; never a funded mainnet key
ANCHOR_PRIVATE_KEY=
# use 2+ on sepolia
CHAIN_CONFIRMATIONS=1
# e.g. https://sepolia.etherscan.io/tx/
EXPLORER_TX_URL=

# NLP (AI never affects verdicts)
NLP_ENABLED=true
NLP_SPACY_MODEL=en_core_web_sm
NLP_EMBEDDINGS_ENABLED=true
NLP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# optional richer explanations
NLP_LLM_EXPLANATIONS=false
ANTHROPIC_API_KEY=
NLP_LLM_MODEL=

# Contracts (used by hardhat.config.ts for sepolia)
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
# optional; address granted ANCHOR_ROLE, defaults to the deployer
ANCHOR_ADDRESS=
ETHERSCAN_API_KEY=

# ---------- Frontend (frontend/.env) ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_EXPLORER_TX_URL=
