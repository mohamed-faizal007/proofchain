# Base URL of the ProofChain API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Client-side hint only (UX, not a security boundary) for the max upload size in MB;
# the server's own limit (Settings.max_upload_mb) is authoritative.
VITE_MAX_UPLOAD_MB=25

# Block explorer "view transaction" base URL; the tx hash is appended directly.
# Leave unset in dev (no explorer for a local Hardhat chain) -- TxLink then renders plain text.
VITE_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/
